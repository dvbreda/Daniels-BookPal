# Kopieer naar .env en pas aan. Alles is optioneel; dit zijn de standaarden.

# --- Waar je collectie staat, op de NAS zelf --------------------------------
# Controleer eerst welke mappen je écht hebt:
#   ls -d /volume1/_*
BOOKPAL_BOEKEN=/volume1/_boeken
BOOKPAL_STRIPS=/volume1/_strips
BOOKPAL_MANGA=/volume1/_manga

# Jouw NAS-gebruiker, zodat de container je collectie kan lezen (bestanden
# staan daar vaak op 600 — alleen de eigenaar mag lezen). Opvragen met:
# `id -u` en `id -g`.
HOST_UID=1000
HOST_GID=1000

# --- Server ------------------------------------------------------------------
# Maximale grootte van de beeldcache in MB (0 = onbeperkt).
BOOKPAL_CACHE_MAX_MB=4096

# Waar database, cache en downloads staan. Binnen Docker regelt compose dit al.
# BOOKPAL_DATA_DIR=./data
# BOOKPAL_CACHE_DIR=./data/cache
# BOOKPAL_DOWNLOAD_DIR=./data/downloads

# Abonnementen automatisch bijwerken en vooruitlezen (M5). Zet op false als je
# liever zelf bepaalt wanneer er verkeer naar een bron gaat.
# BOOKPAL_SUBSCRIPTIONS_ENABLED=true
# BOOKPAL_SUBSCRIPTIONS_INTERVAL_MINUTES=60

# Map met losse bestanden om te importeren: je downloads, een Dropbox-map, wat
# iemand je stuurt. BookPal verplaatst ze van hier naar een van je
# library-mappen. Maak de map zelf aan met je eigen gebruiker, anders maakt
# Docker hem als root aan en mag de server er niets uit halen.
BOOKPAL_INTAKE=/volume1/_intake

# Waar bewaarde vertalingen komen te staan. Standaard in het data-volume; zet
# hier een NAS-pad als je er zelf in wilt kunnen bladeren.
# BOOKPAL_VERTALINGEN=/volume1/_vertalingen

# Sleutel voor vertalingen via Gemini (M8). Zonder sleutel blijft alles gewoon
# werken; de vertaalknop is dan verborgen. Aanmaken op aistudio.google.com.
# BOOKPAL_GEMINI_API_KEY=
# Welk model de tekstwolkjes doet. gemini-3-flash-preview vond in onze eigen
# proef alle acht tekstvlakken op een pagina waar 2.5-flash er zeven zag en
# de vakken bovendien te krap trok.
# BOOKPAL_GEMINI_MODEL=gemini-3-flash-preview
# Waarheen vertaald wordt als een client niets meegeeft.
# BOOKPAL_TRANSLATE_LANG=nl
# De achtergrondwachtrij, en hoeveel pagina's er vooruit vertaald worden vanaf
# je leespositie. 0 zet dat vooruitlopen uit.
# BOOKPAL_TRANSLATIONS_ENABLED=true
# BOOKPAL_TRANSLATE_READAHEAD_PAGES=3

# Gedebouncede tracker-push naar MyAnimeList na een voortgangsupdate (M7). Zet
# op false als je liever zelf op "nu pushen" drukt in de trackerspagina.
# BOOKPAL_TRACKERS_ENABLED=true
# BOOKPAL_TRACKER_DEBOUNCE_SECONDS=20

# --- Claude Code op de NAS (optioneel, zie docker/claude-code.md) -------------
# Alleen nodig als je zonder browser wilt inloggen. Maak de token op een
# machine mét browser via: claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=

# GID van /var/run/docker.sock op de host, zodat de container BookPal kan
# bouwen en herstarten. Opvragen met: stat -c '%g' /var/run/docker.sock
# DOCKER_GID=999
